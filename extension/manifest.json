{
  "manifest_version": 3,
  "name": "Cartoon Auto Bridge",
  "version": "0.1.0",
  "description": "ขับ ChatGPT และ Google Flow ให้ pipeline ทำคลิปการ์ตูนอัตโนมัติ",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["selectors.js", "content-common.js", "content-chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://labs.google/fx/tools/flow*"],
      "js": ["selectors.js", "content-common.js", "content-flow.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Cartoon Auto Bridge" }
}
