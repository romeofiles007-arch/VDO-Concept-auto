# ─────────────────────────────────────────────────────────────
#  API keys — คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า
#  .env ถูก gitignore ไว้แล้ว จะไม่หลุดขึ้น git
# ─────────────────────────────────────────────────────────────

# Claude — ขั้นที่ 1 (script) และ 4 (shot list)   [ทางหลัก]
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini — ขั้นที่ 5 (gen ภาพ)                     [ทางหลัก]
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — ทางเลือกของขั้นที่ 1 (แทน Claude)       [ทางสำรอง]
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs — ทางเลือกของขั้นที่ 2 (แทน TTS local) [ทางสำรอง]
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ─── Bridge (สะพานหา Chrome extension) ───
# token ต้องตรงกับที่กรอกใน popup ของ extension — กันหน้าเว็บอื่นยิงเข้า localhost
BRIDGE_PORT=8765
BRIDGE_TOKEN=
